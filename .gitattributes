# Normalize text to LF in the repository.
* text=auto eol=lf

# Binary archives are never normalized.
*.zip binary

# Frozen oracle artifacts are byte-exact copies of external files; their
# recorded SHA-256 digests must match the checked-out bytes.
tests/golden/haplina_naxx/oracle/** -text

# Only the full raw WCL export lives in Git LFS. The subset fixture is a plain
# blob so ordinary CI never fetches LFS objects.
tests/golden/haplina_naxx/raw/*.zip filter=lfs diff=lfs merge=lfs -text

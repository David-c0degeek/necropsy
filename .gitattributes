# Normalize text to LF in the repository.
* text=auto eol=lf

# Binary archives are never normalized.
*.zip binary

# Frozen oracle artifacts are byte-exact copies of external files; their
# recorded SHA-256 digests must match the checked-out bytes.
tests/golden/haplina_naxx/oracle/** -text

# Full raw exports and Druid captures live in Git LFS. The Hunter subset is a plain
# blob so ordinary CI never fetches LFS objects.
tests/golden/haplina_naxx/raw/*.zip filter=lfs diff=lfs merge=lfs -text
tests/golden/druid/raw/*.zip filter=lfs diff=lfs merge=lfs -text
tests/golden/classes/raw/*.zip filter=lfs diff=lfs merge=lfs -text
tests/golden/raids/raw/*.zip filter=lfs diff=lfs merge=lfs -text
tests/golden/raids/raw/**/*.zip filter=lfs diff=lfs merge=lfs -text

# Evidence references bind exact bytes. Preserve metadata and native sidecars
# across Windows writers, staging and fresh checkouts, including nested captures.
tests/golden/raids/*.json -text
tests/golden/raids/raw/*.entries -text
tests/golden/raids/raw/*.sha256 -text
tests/golden/raids/raw/**/*.entries -text
tests/golden/raids/raw/**/*.sha256 -text

# The capture queue pins these files by SHA-256; keep their exact bytes.
tasks/raid-completion/capture-queue.json -text
tasks/raid-completion/research/capture-*.json -text

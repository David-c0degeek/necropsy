<!doctype html>
<html lang="en" data-theme="dark" data-class="{{ doc.experience.class_key }}" data-raid="{{ doc.experience.raid_key }}" data-faction="{{ doc.experience.faction_key }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<meta name="generator" content="Necropsy {{ doc.necropsy_version }}">
<title>{% block title %}{% endblock %}</title>
<style>{{ css }}</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<aside class="sidebar" aria-label="Necropsy navigation">
  <header class="topbar">
    <div class="brand"><a href="#overview" aria-label="Necropsy overview"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 2 36 11v18L20 38 4 29V11Z M12 28V12l16 16V12 M4 20h8m16 0h8" fill="none" stroke="currentColor" stroke-width="2"/></svg>NECROPSY</a>
      <p>Raid insight. Next-pull clarity.</p>
    </div>
  </header>
  <div class="sidebar-character"><strong>{{ doc.character }}</strong><span>{{ doc.class_name }} · {{ doc.zone }}</span></div>
  <nav class="switch" aria-label="Views">
    <a href="playbook.html"{% if page == "playbook" %} aria-current="page"{% endif %}>Playbook</a>
    <a href="report.html"{% if page == "report" %} aria-current="page"{% endif %}>Report</a>
  </nav>
  <label class="sr" for="boss-search">Filter bosses</label>
  <input id="boss-search" class="search" type="search" placeholder="Filter bosses…" autocomplete="off">
  <label class="sr" for="boss-filter">Boss review filter</label>
  <select id="boss-filter"><option value="all">All encounters</option><option value="attention">With findings</option><option value="limited">Limited comparisons</option><option value="reviewed">Reviewed</option><option value="unreviewed">Not reviewed</option></select>
  <p id="nav-results" class="table-note" role="status"></p>
  <nav class="sidenav" aria-label="Bosses">
    <ol>
      <li><a class="nav-special" href="#overview"><span class="nav-number">00</span><span>Overview</span></a></li>
      <li><a class="nav-special" href="#truth-model"><span class="nav-number">?</span><span>How to read evidence</span></a></li>
      {% for boss in doc.experience.bosses %}
      <li data-boss-name="{{ boss.name|lower }}" data-boss-anchor="{{ boss.anchor }}" data-attention="{{ 'true' if boss.attention else 'false' }}" data-limited="{{ 'true' if boss.limited else 'false' }}"><a href="#{{ boss.anchor }}"><span class="nav-number">{{ "%02d"|format(loop.index) }}</span><span>{{ boss.name }}<small class="nav-state">{{ boss.state }}</small><small class="review-state" data-review-for="{{ boss.anchor }}"></small></span><span class="sr">findings: {{ boss.finding_count }}</span></a></li>
      {% endfor %}
    </ol>
  </nav>
  <div class="sidebar-tools">
    <div class="tools"><button type="button" id="theme-toggle">Theme: system</button></div>
    <p class="table-note">Saved analysis · no background requests</p>
  </div>
</aside>
<nav class="picker" aria-label="Bosses (compact)">
  <details id="boss-picker">
    <summary>Jump to a boss</summary>
    <ol>
      <li><a href="#overview">Overview</a></li>
      <li><a href="#truth-model">How to read evidence</a></li>
      {% for boss in doc.experience.bosses %}
      <li data-boss-name="{{ boss.name|lower }}" data-boss-anchor="{{ boss.anchor }}" data-attention="{{ 'true' if boss.attention else 'false' }}" data-limited="{{ 'true' if boss.limited else 'false' }}"><a href="#{{ boss.anchor }}">{{ boss.name }}<small>{{ boss.state }}</small><span class="sr">findings: {{ boss.finding_count }}</span></a></li>
      {% endfor %}
    </ol>
  </details>
</nav>
<div class="layout">
  <main id="main" tabindex="-1">
{% block main %}{% endblock %}
    <footer class="muted notice">
      <p>Generated by Necropsy {{ doc.necropsy_version }} from <code>analysis.json</code> (schema {{ doc.schema_version }},
      SHA-256 <code>{{ doc.analysis_sha[:12] }}</code>) for archive <code>{{ doc.archive_short }}</code>. Offline: this page loads nothing from the network.</p>
    </footer>
  </main>
</div>
<script>{{ js }}</script>
</body>
</html>

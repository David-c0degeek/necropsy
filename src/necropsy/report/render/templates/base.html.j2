<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<meta name="generator" content="Necropsy {{ doc.necropsy_version }}">
<title>{% block title %}{% endblock %}</title>
<style>{{ css }}</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<aside class="sidebar" aria-label="Playbook navigation">
  <header class="topbar">
    <div class="brand">{{ doc.character }} Definitive Parse Book
      <p>{{ doc.zone }} · Classic Era · {{ doc.reference.faction_label }}</p>
    </div>
  </header>
  <label class="sr" for="boss-search">Filter bosses</label>
  <input id="boss-search" class="search" type="search" placeholder="Filter bosses…" autocomplete="off">
  <nav class="sidenav" aria-label="Bosses">
    <ol>
      <li><a class="nav-special" href="#overview"><span class="nav-number">00</span><span>Overview</span></a></li>
      <li><a class="nav-special" href="#truth-model"><span class="nav-number">★</span><span>Truth model</span></a></li>
      {% for boss in doc.bosses %}
      <li data-boss-name="{{ boss.name|lower }}"><a href="#{{ boss.anchor }}"><span class="nav-number">{{ "%02d"|format(loop.index) }}</span><span>{{ boss.name }}</span><span class="sr">finding{{ "" if boss.cards|length == 1 else "s" }}: {{ boss.cards|length }}</span></a></li>
      {% endfor %}
    </ol>
  </nav>
  <div class="sidebar-tools">
    <nav class="switch" aria-label="Views">
      <a href="report.html"{% if page == "report" %} aria-current="page"{% endif %}>Report</a>
      <a href="playbook.html"{% if page == "playbook" %} aria-current="page"{% endif %}>Playbook</a>
    </nav>
    <div class="tools"><button type="button" id="theme-toggle">Theme: system</button></div>
  </div>
</aside>
<nav class="picker" aria-label="Bosses (compact)">
  <details id="boss-picker">
    <summary>Jump to a boss</summary>
    <ol>
      <li><a href="#overview">Overview</a></li>
      <li><a href="#truth-model">★ Truth model</a></li>
      {% for boss in doc.bosses %}
      <li data-boss-name="{{ boss.name|lower }}"><a href="#{{ boss.anchor }}">{{ "%02d"|format(loop.index) }} {{ boss.name }} <span class="sr">finding{{ "" if boss.cards|length == 1 else "s" }}: {{ boss.cards|length }}</span></a></li>
      {% endfor %}
    </ol>
  </details>
</nav>
<div class="layout">
  <main id="main" tabindex="-1">
{% block main %}{% endblock %}
    <footer class="muted notice">
      <p>Generated by Necropsy {{ doc.necropsy_version }} from <code>analysis.json</code> (schema {{ doc.schema_version }},
      SHA-256 <code>{{ doc.analysis_sha[:12] }}</code>) for archive <code>{{ doc.archive_short }}</code>. Offline: this page loads nothing from the network.</p>
    </footer>
  </main>
</div>
<script>{{ js }}</script>
</body>
</html>

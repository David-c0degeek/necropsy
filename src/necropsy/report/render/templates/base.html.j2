<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<meta name="generator" content="Necropsy {{ doc.necropsy_version }}">
<title>{% block title %}{% endblock %}</title>
<style>{{ css }}</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
  <div class="brand">Necropsy <span>·</span> {{ doc.character }} · {{ doc.zone }}</div>
  <nav class="switch" aria-label="Views">
    <a href="report.html"{% if page == "report" %} aria-current="page"{% endif %}>Report</a>
    <a href="playbook.html"{% if page == "playbook" %} aria-current="page"{% endif %}>Playbook</a>
  </nav>
  <div class="tools">
    <button type="button" id="theme-toggle">Theme: system</button>
  </div>
</header>
<nav class="picker" aria-label="Bosses (compact)">
  <details id="boss-picker">
    <summary>Jump to a boss</summary>
    <ol>
      <li><a href="#overview">Overview</a></li>
      {% for boss in doc.bosses %}
      <li><a href="#{{ boss.anchor }}">{{ boss.name }} <span class="count">{{ boss.cards|length }} finding{{ "" if boss.cards|length == 1 else "s" }}</span></a></li>
      {% endfor %}
    </ol>
  </details>
</nav>
<div class="layout">
  <nav class="sidenav" aria-label="Bosses">
    <ol>
      <li><a href="#overview"><span>Overview</span></a></li>
      {% for boss in doc.bosses %}
      <li><a href="#{{ boss.anchor }}"><span>{{ boss.name }}</span><span class="count">{{ boss.cards|length }}<span class="sr"> finding{{ "" if boss.cards|length == 1 else "s" }}</span></span></a></li>
      {% endfor %}
    </ol>
  </nav>
  <main id="main" tabindex="-1">
{% block main %}{% endblock %}
    <footer class="muted notice">
      <p>Generated by Necropsy {{ doc.necropsy_version }} from <code>analysis.json</code> (schema {{ doc.schema_version }},
      SHA-256 <code>{{ doc.analysis_sha[:12] }}</code>) for archive <code>{{ doc.archive_short }}</code>. Offline: this page loads nothing from the network.</p>
    </footer>
  </main>
</div>
<script>{{ js }}</script>
</body>
</html>

{% extends "base.html.j2" %}
{% from "reference-macros.html.j2" import plans, equipment, prose %}
{% from "macros.html.j2" import val, evidence %}
{% from "ability-use.html.j2" import ability_use %}
{% from "pull-sheet.html.j2" import pull_sheet %}
{% macro ev(e) -%}
{% if e and e.value is not none %}{{ e.value }} <span class="level">{{ e.level }}</span>{% else %}<span class="unknown">Unknown</span>{% if e and e.note %} <span class="why">{{ e.note }}</span>{% endif %}{% endif %}
{%- endmacro %}
{% macro actor(d, id) -%}
{% set catalog = (d.get('actor_catalog') or {}).get('value') or {} %}{% set found = catalog.get(id|string) or {} %}{{ found.get('name') or ('Unresolved actor ' ~ id) }}{% if found.get('type') %} ({{ found.type }}){% endif %}
{%- endmacro %}
{% macro coaching(ref, boss) %}
<section id="boss-{{ boss.encounter_id }}-plan" class="next-pull" aria-labelledby="boss-{{ boss.encounter_id }}-plan-title">
  <div class="eyebrow">Turn the analysis into practice</div>
  <h3 id="boss-{{ boss.encounter_id }}-plan-title" tabindex="-1">Your next pull</h3>
  <article class="quick-plan"><h4>Opening cycle and encounter notes</h4>{{ plans(ref.quick_plan) }}</article>
  <section class="loadout-plan"><h3>Loadout plan</h3>{{ plans(ref.loadout) }}</section>
  <section class="execution-plan"><h3>Execution plan</h3>{{ plans(ref.execution) }}</section>
  <div class="grid two warnings"><article class="dont"><h4>Keep in mind</h4>{{ prose(ref.dont) }}</article><article class="ask"><h4>Raid help</h4>{{ prose(ref.asks) }}</article></div>
</section>
{% endmacro %}
{% macro comparison_snapshot(ref, boss) %}
<section id="boss-{{ boss.encounter_id }}-comparison" class="comparison-snapshot" aria-labelledby="boss-{{ boss.encounter_id }}-comparison-title">
  <div class="eyebrow">Understand the difference</div>
  <h3 id="boss-{{ boss.encounter_id }}-comparison-title" tabindex="-1">Compared with your faction</h3>{% if boss.playbook.get('reference_context') %}{% from "reference-context.html.j2" import reference_context %}{{ reference_context(boss) }}{% endif +%}
  {% set comparisons = boss.playbook.get('comparisons') or [] %}
  {% if comparisons %}
    <p>{{ comparisons|length }} matching event source{{ 's' if comparisons|length != 1 else '' }}.{% if comparisons|length < 3 %} <strong>Limited sample: only {{ comparisons|length }} source{{ 's' if comparisons|length != 1 else '' }}; compare individual fights, not a population baseline.</strong>{% endif %}</p>
    {% for row in ref.comparison_rows %}
    <div class="comparison-row">
      <h4>{{ row.label }}</h4>
      <div class="comparison-values"><div><span>You</span><strong>{{ row.yours }}</strong></div><div><span>{{ row.player }} · individual reference</span><strong>{{ row.reference }}</strong></div><div><span>You minus reference</span><strong>{{ row.difference }}{% if row.percent %} <small>({{ row.percent }})</small>{% endif %}</strong></div></div>
    </div>
    {% endfor %}
    <p class="table-note">Fight length, assignments, buffs and targets can explain differences. Incoming damage and healing throughput are not quality scores.</p>
  {% else %}
    <p>{{ 'No matching event samples were acquired. Your measurements remain available below.' if boss.subject else 'Your performance is not assessed for this boss in the selected spec.' }}</p>
  {% endif %}
  {{ ability_use(ref.abilities) }}
</section>
{% endmacro %}
{% block title %}{{ doc.title }} · {{ doc.class_name }} {{ page }}{% endblock %}
{% block main %}
{% include "overview.html.j2" %}
{% set selected = doc.selected_spec %}
{% set personal_count = doc.class_document.bosses|selectattr('subject')|list|length %}
{% if page == 'report' %}
<section class="global analysis-context" aria-label="Analysis context">
  <details><summary>Available data and limitations</summary>
  <p>Coverage describes what the logs can tell us, not sync progress. Missing fights or uncertain pet usage can limit specific results; the notes below explain what is affected.</p>
  <p>WCL comparison category: {{ doc.taxonomy.comparison_pool.label if doc.taxonomy else ('Tank (Guardian category)' if selected == 'Guardian' else selected or 'Unknown') }} · selected faction: {{ doc.selected_faction or 'Unknown' }}.</p>
  <p>{{ personal_count }} encounters with your matching data · {{ doc.navigation|length - personal_count }} without personal analysis.</p>
  {% if selected and personal_count == 0 %}<p class="notice">Not enough personal data in {{ 'Tank' if selected == 'Guardian' else selected }} in the acquired logs. Eligible top-player examples are shown for learning where available.</p>{% endif %}
  <dl class="kv">{% for label, value in doc.coverage %}<dt>{{ label }}</dt><dd>{{ value }}</dd>{% endfor %}</dl>
  {% for limit in doc.limitations %}<p class="muted">{{ limit }}</p>{% endfor %}
  {% if doc.class_document.get('acquisition') %}
  {% if doc.class_document.acquisition.get('stopped') %}<p>Acquisition stopped: {{ doc.class_document.acquisition.stopped }}. Unacquired examples and baselines remain unknown; this does not establish that personal spec data never existed.</p>{% endif %}
  <div class="table-wrap" role="region" aria-label="Detailed analysis table" tabindex="0"><table><thead><tr><th>Requested encounter</th><th>Attempted</th><th>Deep samples</th><th>Data coverage</th><th>Coverage notes</th></tr></thead><tbody>{% for record in doc.class_document.acquisition.bosses %}{% set coverage = record.get('coverage') or {} %}<tr><th>{{ record.boss }}</th><td>{{ record.get('attempted', true) }}</td><td>{{ coverage.get('usable_deep', 'Unknown') }}</td><td>{{ 'Not attempted' if record.get('attempted') == false else 'Complete' if coverage.get('complete') == true else 'Limited data' if coverage.get('complete') == false else 'Unknown' }}</td><td>{% if coverage.get('reasons') %}<ul>{% for reason in coverage.reasons %}<li>{{ reason }}</li>{% endfor %}</ul>{% else %}No coverage notes recorded.{% endif %}</td></tr>{% endfor %}</tbody></table></div>
  {% endif %}
  </details>
</section>
<section id="truth-model" class="global truth-model">
  <details><summary>Evidence and comparison limits</summary><h2 tabindex="-1">Evidence and comparison limits</h2>
  <p>Role is inferred from repeated actions. Talents, form and leaderboard labels alone never prove assigned duties. Unknown values remain unknown.</p>
  <p>The main comparison uses the same faction, category, role, metric, partition and encounter. Builds are shown per player rather than used to hide sources. One or two sources still provide individual comparisons, clearly labelled as a limited sample; medians require three known values. Mixed, uncertain and overridden duties have no whole-fight baseline.</p>
  <p>Healing is shaped by assignments, incoming damage and other healers. Tank-category DPS does not measure survival or threat. Raw event damage and healing remain separate from WCL category scores.</p>
  </details>
</section>
<section id="raid-sheet" class="global"><details><summary>Raid measurements · all encounters</summary>
  <div class="table-wrap raid-sheet"><table class="stack"><thead><tr><th>Boss</th><th>Your encounter</th><th>Your throughput</th><th>Faction leader</th><th>Leader throughput</th><th>Event sources</th></tr></thead><tbody>
  {% for b in doc.class_document.bosses %}{% set ref = doc.class_views[b.encounter_id] %}<tr><th scope="row"><a href="#boss-{{ b.encounter_id }}">{{ b.boss }}</a></th><td data-label="Your encounter">{{ 'Available' if b.subject else 'No personal data in this spec' }}</td><td data-label="Your throughput">{{ val(ref.metrics[0][1]) }}</td><td data-label="Faction leader">{{ b.playbook.reference.player if b.playbook.get('reference') else 'Event example not acquired' }}</td><td data-label="Leader throughput">{{ val(ref.metrics[1][1]) }}</td><td data-label="Event sources">{{ val(ref.metrics[3][1]) }}</td></tr>{% endfor %}</tbody></table></div>
  <p class="table-note">Throughput is role-specific: damage, effective healing or incoming damage per second. Incoming damage and HPS are not quality scores. One or two sources remain labelled individual comparisons.</p>
</details></section>
{% endif %}
<p class="notice"><span id="review-status">Review marks are saved only in this browser, for this exact analysis.</span> <button type="button" id="reset-reviews">Clear review marks</button></p>
{% for boss in doc.class_document.bosses %}
<section id="boss-{{ boss.encounter_id }}" class="boss boss-section" aria-labelledby="boss-{{ boss.encounter_id }}-title">
  {% set ref = doc.class_views[boss.encounter_id] %}
  {% set triage = doc.experience.bosses[loop.index0] %}
  {% if page == 'playbook' %}
  <div class="boss-head"><div><div class="eyebrow">Boss {{ '%02d'|format(loop.index) }}</div><h2 id="boss-{{ boss.encounter_id }}-title" tabindex="-1">{{ boss.boss }}</h2></div><label class="done"><input type="checkbox" data-review-key="{{ ref.review_key }}"> reviewed<span class="sr">: {{ boss.boss }}</span></label></div>
  {% if triage.limited %}<p class="table-note">{{ triage.quality }}. {{ triage.quality_note or 'Advice may be limited by the available comparisons.' }}</p>{% endif %}
  {{ pull_sheet(ref, ref.actions, 'boss-' ~ boss.encounter_id, boss.subject is not none) }}{% if boss.playbook.get('reference_context') %}{% from "reference-context.html.j2" import reference_context %}{{ reference_context(boss) }}{% if boss.playbook.reference_context.statements|selectattr('scope', 'equalto', 'overall-reference')|list %}<details class="overall-comparison"><summary>Optional: overall top across factions</summary>{{ reference_context(boss, 'overall-reference') }}</details>{% endif %}{% endif %}{% if boss.playbook.get('class_notes') %}{% from "class-notes.html.j2" import class_notes %}{{ class_notes(boss) }}{% endif +%}
  {% else %}
  <div class="boss-head"><div><div class="eyebrow">Boss {{ '%02d'|format(loop.index) }} · {{ boss.boss }}</div><h2 id="boss-{{ boss.encounter_id }}-title" tabindex="-1">{{ boss.boss }}</h2><div class="metrics">{% for label, value in ref.metrics %}<div><b>{{ val(value) }}</b><span>{{ label }}</span></div>{% endfor %}</div></div><label class="done"><input type="checkbox" data-review-key="{{ ref.review_key }}"> reviewed<span class="sr">: {{ boss.boss }}</span></label></div>
  <details class="role-context"><summary>Role, category and coverage context</summary><div class="context-strip">{% for label, value in ref.context %}<div><span>{{ label }}</span><strong>{{ value }}</strong></div>{% endfor %}</div></details>
  <div class="quality-strip"><strong>{{ 'Not assessed · no matching personal data' if not boss.subject else triage.quality }}</strong><span>{{ triage.sources }} comparable event sources{% if triage.membership_label %} · {{ triage.membership_label }}{% endif %} · source counts vary by measurement</span></div>
  {% if triage.quality_note %}<p class="table-note">{{ triage.quality_note }}</p>{% endif %}{% if boss.playbook.get('class_notes') %}{% from "class-notes.html.j2" import class_notes %}{{ class_notes(boss) }}{% endif %}
  <nav class="boss-jumps" aria-label="{{ boss.boss }} sections"><a href="#boss-{{ boss.encounter_id }}-actions">What to work on</a><a href="#boss-{{ boss.encounter_id }}-plan">Next pull</a><a href="#boss-{{ boss.encounter_id }}-comparison">Compare</a><a href="#boss-{{ boss.encounter_id }}-evidence">Evidence</a></nav>
  <section id="boss-{{ boss.encounter_id }}-actions" class="boss-actions" aria-labelledby="boss-{{ boss.encounter_id }}-actions-title">
    <h3 id="boss-{{ boss.encounter_id }}-actions-title" tabindex="-1">What to work on</h3>
    {% for action in ref.actions %}
    <article class="card action-card">
      <h4>{{ action.recommendation }}</h4>
      <p class="finding">{{ action.finding }}</p>
      <details><summary>Why this was flagged · evidence and limits</summary>
        <p class="table-note">Severity describes the finding; confidence describes its evidence. Starting order does not predict a performance gain.</p>
      <ul class="badges" aria-label="Finding classification"><li class="badge sev-{{ action.severity }}">Severity: {{ action.severity }}</li><li class="badge conf-{{ action.confidence }}">{{ action.confidence|capitalize }} confidence</li><li class="badge">{{ action.control_label }}</li></ul>
        {% for item in action.evidence_views %}{{ evidence(item) }}{% endfor %}
        <ul class="limitations">{% for limit in action.limitations %}<li>{{ limit }}</li>{% endfor %}</ul>
      </details>
    </article>
    {% else %}<p>{{ 'No personal finding is available. The recorded example below is for learning, not an assessment of your performance.' if not boss.subject else 'No supported recommendation was generated. This does not establish that every aspect of the fight was assessed; review comparisons and coverage below.' }}</p>{% endfor %}
    {% if boss.playbook.get('assessment_limits') %}<p>Assessment limits:</p><ul>{% for limit in boss.playbook.assessment_limits %}<li>{{ limit }}</li>{% endfor %}</ul>{% endif %}
  </section>
  {{ comparison_snapshot(ref, boss) }}{{ coaching(ref, boss) }}
  <h3 id="boss-{{ boss.encounter_id }}-evidence" tabindex="-1">Evidence and details</h3>
  {% if page == 'report' and ref.duty_lines is defined %}<div class="encounter-duty">{{ prose(ref.duty_lines) }}</div>{% endif %}
  {% if page == 'report' and ref.strategy_lines is defined %}<details class="encounter-strategy"><summary>General encounter strategy and sources</summary><div>{{ prose(ref.strategy_lines) }}<p class="table-note">{{ ref.strategy_limitation }}</p></div></details>{% endif %}
  <details><summary>Who are you being compared with?</summary><p>{{ boss.benchmarks.baseline.note }}</p><p>{{ boss.benchmarks.baseline.entries }} comparable event sources. Build, race, faction buffs, fight length and assignments can affect comparisons. Ranking scores remain separate from event metrics.</p></details>
  <details class="full-gear"><summary>Your full logged gear for this selected encounter</summary><div>{{ equipment(ref.gear) }}</div></details>
  {% if ref.encounter_facts %}<details><summary>Encounter knowledge and sources</summary><div>{{ prose(ref.encounter_facts) }}</div></details>{% endif %}
  <details class="leader-gear"><summary>Faction leader's full logged gear and enchants</summary><div>{{ equipment(ref.leader_gear) }}</div></details>
  {% if doc.analysis_key == 'combat' %}<details class="pet-evidence"><summary>Pet and summon evidence</summary><div>
  {% for entry in ([boss.subject] if boss.subject else []) + boss.overall_cohort %}{% set combat = entry[doc.analysis_key] %}<h3>{{ entry.player }}</h3>
  {% if not combat.pets_known %}<p>Unknown — the owned-pet listing is incomplete.</p>{% endif %}
  {% for pet in combat.pets %}<h4>{{ pet.name }}</h4><dl class="kv"><dt>Damage</dt><dd>{{ ev(pet.damage) }}</dd><dt>DPS</dt><dd>{{ ev(pet.dps) }}</dd><dt>Deaths</dt><dd>{{ pet.deaths.deaths.value|length if pet.deaths.deaths.value is not none else 'Unknown' }}</dd><dt>Ability use</dt><dd>{% if pet.casts.value is not none %}{% for name, count in pet.casts.value.items() %}{{ name }}: {{ count }}{{ '; ' if not loop.last else '' }}{% else %}No recorded casts{% endfor %}{% else %}Unknown{% endif %}</dd></dl>{% else %}<p>No owned pet/summon entries were acquired; listing completeness still applies.</p>{% endfor %}
  {% endfor %}</div></details>{% endif %}
  {% if not boss.subject %}
  <div class="notice"><p>{{ boss.playbook.get('personal_data', {}).get('message', 'Not enough personal data in this spec for this encounter.') }}</p>
  <p>Your performance is not assessed for this boss in the selected spec.</p>
  {% set excluded = boss.playbook.get('personal_data', {}).get('excluded_fight') %}{% if excluded %}<p>The acquired fight {{ excluded.report }}/{{ excluded.fight }} has inferred duty {{ excluded.inferred_role or 'unknown' }} and is excluded from personal analysis in this view.</p>{% endif %}
  {% if boss.playbook.get('personal_data', {}).get('reasons') %}<details><summary>Why personal data is unavailable</summary><ul>{% for reason in boss.playbook.personal_data.reasons %}<li>{{ reason }}</li>{% endfor %}</ul></details>{% endif %}</div>
  {% else %}
  {% set s = boss.subject %}{% set d = s[doc.analysis_key] %}
  <p><a href="https://vanilla.warcraftlogs.com/reports/{{ s.report_code }}#fight={{ s.fight_id }}" target="_blank" rel="noopener noreferrer">Source report {{ s.report_code }} / fight {{ s.fight_id }}</a> · source opens online when followed</p>
  {% if d.override %}<p class="notice">User override: {{ d.override.role }} · {{ d.override.reason }}. Observed evidence is retained; override is excluded from aggregate comparison.</p>{% endif %}
  <details class="measurements"><summary>Your measurements · full comparisons and event detail</summary><div>
  <h3>Your measurements</h3>
  {% set comparisons = boss.playbook.get('comparisons') or [] %}
  {% if comparisons %}
  <h3>You vs top players in your faction</h3>
  <p>{{ comparisons|length }} event sources in this spec and faction.{% if comparisons|length < 3 %} <strong>Limited sample: only {{ comparisons|length }} source{{ 's' if comparisons|length != 1 else '' }}; compare these individual fights, not a broad population baseline.</strong>{% endif %}
  {% if d.build.value is not none %}{{ boss.benchmarks.baseline.get('builds_differing', 0) }} sources have a known build different from yours.{% else %}Your talent build is unknown; event comparisons do not require talent data.{% endif %}
  {% if boss.benchmarks.baseline.get('builds_unknown', 0) %} {{ boss.benchmarks.baseline.builds_unknown }} source builds are unknown.{% endif %} Fight duration, assignments, buffs and targets can explain differences.</p>
  {% set best = comparisons[0] %}<h4>Direct comparison: {{ best.player }} · leaderboard #{{ best.leaderboard_position }}</h4>
  <p>Build {{ ev(best.build) }} · {{ best.kill_duration_s }} s fight.</p>
  <dl class="kv">{% for name in boss.playbook.primary_metrics %}{% set values = best.metrics.get(name) %}{% if values %}<dt>{{ name|replace('_', ' ') }}</dt><dd>You: {{ '%.2f'|format(values.yours) if values.yours is not none else 'Unknown' }} · {{ best.player }}: {{ '%.2f'|format(values.reference) if values.reference is not none else 'Unknown' }}<br>You minus source: {{ '%+.2f'|format(values.difference) if values.difference is not none else 'Unknown' }}{% if values.difference_pct is not none %} ({{ '%+.1f'|format(values.difference_pct) }}%){% endif %}</dd>{% endif %}{% endfor %}</dl>
  <details><summary>All {{ comparisons|length }} individual event-source comparisons</summary>
  <div class="table-wrap" role="region" aria-label="Detailed analysis table" tabindex="0"><table><thead><tr><th>Source</th><th>Build / fight</th><th>Measurement</th><th>You</th><th>Top player</th><th>You minus source</th></tr></thead><tbody>
  {% for comparison in comparisons %}{% for name, values in comparison.metrics.items() %}{% if page == 'report' or name in boss.playbook.primary_metrics %}
  <tr><th><a href="https://vanilla.warcraftlogs.com/reports/{{ comparison.report_code }}#fight={{ comparison.fight_id }}" target="_blank" rel="noopener noreferrer">{{ comparison.player }} · leaderboard #{{ comparison.leaderboard_position }}</a></th><td>{{ ev(comparison.build) }} · {{ comparison.kill_duration_s }} s</td><td>{{ name|replace('_', ' ') }}</td><td>{{ values.yours if values.yours is not none else 'Unknown' }}</td><td>{{ values.reference if values.reference is not none else 'Unknown' }}</td><td>{% if values.difference is not none %}{{ '%+.2f'|format(values.difference) }}{% if values.difference_pct is not none %} ({{ '%+.1f'|format(values.difference_pct) }}%){% endif %}{% else %}Unknown{% endif %}</td></tr>
  {% endif %}{% endfor %}{% endfor %}</tbody></table></div>
  </details>
  {% else %}<p>No matching event samples were acquired; see the saved #1 ranking comparison below where available.</p>{% endif %}
  {% if boss.benchmarks.baseline.entries < 3 %}<p>Fewer than three event sources: the individual comparisons above remain usable; a cohort median is not shown.</p>{% endif %}
  <p>{{ boss.benchmarks.baseline.entries }} comparable entries; {{ boss.benchmarks.baseline.excluded_incompatible }} incompatible entries excluded. {{ boss.benchmarks.baseline.note }}</p>
  <div class="table-wrap" role="region" aria-label="Detailed analysis table" tabindex="0"><table><thead><tr><th>Measurement</th><th>Yours</th><th>Comparable median</th><th>Known / unknown</th></tr></thead><tbody>
  {% for name, measurement in d.metrics.items() %}{% if page == 'report' or name in boss.playbook.get("primary_metrics", []) %}{% set median = boss.benchmarks.baseline.medians.get(name) %}
  <tr><th>{{ name|replace('_', ' ') }}</th><td>{{ ev(measurement) }}</td><td>{{ ev(median.value if median else none) }}</td><td>{{ median.n_known if median else 0 }} / {{ median.n_unknown if median else 0 }}</td></tr>{% endif %}{% endfor %}
  </tbody></table></div>
  <p>Saved WCL category score: {{ s.ranking.category_score if s.ranking.category_score is not none else 'Unknown' }} {{ s.ranking.metric or '' }} · {{ s.ranking.note }}</p>
  <details><summary>Observed roles, forms, resources and full timeline</summary>
    <h3>Observed activity spans</h3><ul>{% for span in d.activity_spans %}<li>{{ span.role }}: {{ span.first_action_s }}–{{ span.last_action_s }} s; {{ span.casts_observed }} recorded casts · {{ (span.get("cast_share", 1) * 100)|round(1) }}% of categorized casts · {{ 'qualifying duty' if span.get("qualifies_as_duty", true) else 'minor action signal; assignment unproven' }}</li>{% else %}<li>No supported activity spans.</li>{% endfor %}</ul>
    {% if doc.analysis_key == "druid" %}<h3>Form intervals (report timestamps, ms)</h3><dl class="kv">{% for name, intervals in d.forms.items() %}<dt>{{ name }}</dt><dd>{{ ev(intervals) }}</dd>{% endfor %}</dl>
    {% endif %}<h3>Ability use</h3><p>{{ ev(d.casts) }}</p>
    <h3>Environment and external context</h3><dl class="kv"><dt>Faction</dt><dd>{{ ev(s.environment.faction) }}</dd><dt>Race</dt><dd>{{ ev(s.environment.race.race) }}</dd><dt>Starting world buffs</dt><dd>{{ ev(s.environment.world_buffs) }}</dd><dt>Windfury</dt><dd>{{ ev(s.environment.windfury.status_evidence) }}</dd></dl>
    <h3>Effective healing by spell</h3><p>{{ ev(d.get("healing_spells")) }}</p>
    <h3>Defensive aura uptime (s)</h3><dl class="kv">{% for name, value in d.get("defensive_uptime_s", {}).items() %}<dt>{{ name }}</dt><dd>{{ ev(value) }}</dd>{% endfor %}</dl>
    <h3>Targets and support</h3><dl class="kv"><dt>Effective healing by target</dt><dd>{% if d.healing_targets.value is not none %}{% for id, amount in d.healing_targets.value.items() %}{{ actor(d, id) }}: {{ amount }}{{ '; ' if not loop.last else '' }}{% else %}No recorded healing targets{% endfor %}{% else %}{{ ev(d.healing_targets) }}{% endif %}</dd><dt>Damage by target</dt><dd>{% if d.damage_targets.value is not none %}{% for id, amount in d.damage_targets.value.items() %}{{ actor(d, id) }}: {{ amount }}{{ '; ' if not loop.last else '' }}{% else %}No recorded damage targets{% endfor %}{% else %}{{ ev(d.damage_targets) }}{% endif %}</dd><dt>Deaths</dt><dd>{{ ev(d.deaths.deaths) }}</dd><dt>Threat</dt><dd>{{ ev(d.threat) }}</dd></dl>
    <h3>Resource observations</h3><ul>{% for r in d.resources %}<li>{{ r.t_s }} s · {{ ev(r.get("evidence")) }} · raw payload: {{ r.reading }} · event {{ r.event_uid }}</li>{% else %}<li>No actor-resolved resource readings. Resource availability remains unknown.</li>{% endfor %}</ul>
    <h3>Cooldown and utility casts</h3><ul>{% for e in d.cooldowns %}<li>{{ e.t_s }} s · {{ e.name }} · target {{ e.target_id }} · event {{ e.uid }}/{{ e.get('copy') if e.get('copy') is not none else 'Unknown' }}</li>{% else %}<li>No recorded cooldown casts. Check source coverage before claiming non-use.</li>{% endfor %}</ul>
    <h3>Full event timeline</h3><div class="table-wrap" role="region" aria-label="Detailed analysis table" tabindex="0"><table><thead><tr><th>Time (s)</th><th>Event / ability</th><th>Source → target</th><th>Amount</th><th>Event identity</th></tr></thead><tbody>{% for e in d.timeline %}<tr><td>{{ e.t_s }}</td><td>{{ e.kind }} · {{ e.name or e.ability_id }}</td><td>{{ actor(d, e.source_id) }} → {{ actor(d, e.target_id) }}</td><td>{{ e.amount if e.amount is not none else 'Unknown' }}</td><td>{{ e.uid }}/{{ e.get('copy') if e.get('copy') is not none else 'Unknown' }}</td></tr>{% endfor %}</tbody></table></div>
  </details>
  </div></details>
  {% endif %}
  {% set reference = boss.playbook.get('reference') %}
  {% set ranking_comparison = boss.playbook.get('ranking_comparison') %}
  {% if ranking_comparison %}
  {% set scope = ('best recorded ' ~ ranking_comparison.faction ~ ' source') if ranking_comparison.get('scope') == 'same-faction-recorded' else 'overall #1' %}
  <div class="quick-plan ranking-comparison"><h3>{{ 'Your WCL score vs ' ~ scope if boss.subject else scope|capitalize ~ ' WCL score for learning' }}</h3>
  <p>{{ ranking_comparison.player }} · overall leaderboard #{{ ranking_comparison.get('leaderboard_position', 1) }} · 1 ranking source · {{ ranking_comparison.metric }}. Limited sample: this is one recorded top performance.</p>
  {% if ranking_comparison.get('faction') %}<p>Faction: {{ ranking_comparison.faction }} ({{ ranking_comparison.faction_evidence }}). Best same-faction source found in the saved rankings; unresolved earlier players prevent a claim of faction rank #1.</p>{% endif %}
  <dl class="kv">{% if boss.subject %}<dt>Your saved WCL score</dt><dd>{{ ranking_comparison.yours if ranking_comparison.yours is not none else 'Unknown' }}</dd>{% endif %}<dt>Reference saved WCL score</dt><dd>{{ ranking_comparison.reference }}</dd>{% if boss.subject %}<dt>You minus reference</dt><dd>{% if ranking_comparison.difference is not none %}{{ '%+.2f'|format(ranking_comparison.difference) }}{% if ranking_comparison.difference_pct is not none %} ({{ '%+.1f'|format(ranking_comparison.difference_pct) }}%){% endif %}{% else %}Unknown{% endif %}</dd>{% endif %}</dl>
  <p>Saved WCL ranking scores are compared with WCL ranking scores. This does not establish an event-metric gap, an optimal rotation or player fault. Guardian DPS is not tank quality; HPS depends on healing assignments.</p></div>
  {% if ranking_comparison.get('report_code') and ranking_comparison.get('fight_id') %}<p><a href="https://vanilla.warcraftlogs.com/reports/{{ ranking_comparison.report_code }}#fight={{ ranking_comparison.fight_id }}" target="_blank" rel="noopener noreferrer">Ranking reference source / fight {{ ranking_comparison.fight_id }}</a></p>{% endif %}
  {% endif %}
  <details class="learning-example"{% if not boss.subject %} open{% endif %}><summary>Learn from the recorded faction example</summary><div class="quick-plan">
    <h3>{{ 'Your practice playbook from faction leaders' if not boss.subject else 'Learn from top players in your spec and faction' }}</h3>
    {% if reference %}{% set rd = reference[doc.analysis_key] %}
    <p><strong>{{ reference.player }}</strong> · {{ 'Rank #1 recorded example' if reference.leaderboard_position == 1 else 'Top acquired example · leaderboard #' ~ reference.leaderboard_position }}.</p>
    <p>{{ boss.playbook.reference_note }}</p>
    <dl class="kv"><dt>Inferred duty</dt><dd>{{ ev(rd.role) }}</dd><dt>Build</dt><dd>{{ ev(rd.build) }}</dd><dt>Faction</dt><dd>{{ ev(reference.environment.faction) }}</dd><dt>Race</dt><dd>{{ ev(reference.environment.race.race) }}</dd><dt>Fight duration</dt><dd>{{ reference.kill_duration_s }} s</dd></dl>
    <p>{{ boss.playbook.guidance }}</p>
    <p>Recorded opening example: {% for e in rd.opener %}{{ ' → ' if not loop.first else '' }}{{ e.t_s }}s {{ e.name or e.ability_id }}{% else %}Unknown{% endfor %}</p>
    {% if not boss.subject %}<p>Start with this recorded opener and ability mix as your practice reference. Confirm the encounter assignment with your raid before copying a leader's decisions.</p><h4>Recorded ability use to practice</h4><dl class="kv">{% for spell, count in (rd.casts.value or {}).items() %}<dt>{{ spell }}</dt><dd>{{ count }} casts · {{ '%.2f'|format(count * 60 / reference.kill_duration_s) }} per minute</dd>{% else %}<dt>Ability use</dt><dd>Unknown</dd>{% endfor %}</dl>{% endif %}
    <dl class="kv">{% for name in boss.playbook.primary_metrics %}<dt>{{ name|replace('_', ' ') }}</dt><dd>{{ ev(rd.metrics.get(name)) }}</dd>{% endfor %}</dl>
    <p><a href="https://vanilla.warcraftlogs.com/reports/{{ reference.report_code }}#fight={{ reference.fight_id }}" target="_blank" rel="noopener noreferrer">Example source report / fight {{ reference.fight_id }}</a></p>
    {% else %}<p>No eligible event example was acquired in the selected spec. Unknown duty, incomplete coverage and incompatible categories do not become learning examples.</p>{% endif %}
  </div></details>
  <details class="overall-comparison"><summary>Optional: overall top across factions</summary>{% if boss.playbook.get('reference_context') %}{% from "reference-context.html.j2" import reference_context %}{{ reference_context(boss, 'overall-reference') }}{% endif +%}
    <p>This comparison is unfiltered by faction. Race, faction-specific buffs, assignments and fight duration may differ; use it as additional context.</p>
    {% set top = boss.benchmarks.get('overall_top') %}
    {% if top %}<p>Saved overall #1 {{ top.category }} ranking: {{ top.player }} · {{ ev(top.category_score) }} {{ top.metric }}. {{ top.note }}</p>{% if not reference or reference.leaderboard_position != 1 %}<p>Overall #1 event example: unknown (not acquired or not eligible). Cross-faction acquisition can supply another-faction #1 when accessible.</p>{% endif %}
    <p>Your selected faction: {{ boss.playbook.get('selected_faction') or 'Unknown' }} · leader faction: {{ top.get('player_faction') or 'Unknown' }} ({{ top.get('faction_evidence') or 'unknown' }}).{% if top.get('player_faction') and boss.playbook.get('selected_faction') and top.player_faction != boss.playbook.selected_faction %} <strong>Faction differs: faction-specific buffs and racials can affect this comparison.</strong>{% endif %}</p>
    {% if boss.subject and boss.subject.ranking.category_score is not none and boss.subject.ranking.metric == top.metric %}<p>Your saved WCL score: {{ boss.subject.ranking.category_score }} {{ top.metric }} · overall #1: {{ top.category_score.value }} {{ top.metric }} · difference: {{ '%+.2f'|format(boss.subject.ranking.category_score - top.category_score.value) }}.</p>{% endif %}
    {% else %}<p>Overall #1 ranking metadata: unknown (not acquired).</p>{% endif %}
    {% set overall = boss.playbook.get('overall_reference') %}{% if overall %}<p>Highest-ranked acquired eligible event example across factions: {{ overall.player }} · leaderboard #{{ overall.leaderboard_position }} · faction {{ ev(overall.environment.faction) }} · build {{ ev(overall[doc.analysis_key].build) }}.</p><p>Recorded opening: {% for e in overall[doc.analysis_key].opener %}{{ ' → ' if not loop.first else '' }}{{ e.t_s }}s {{ e.name or e.ability_id }}{% else %}Unknown{% endfor %}</p>{% endif %}
    {% set overall_comparison = boss.playbook.get('overall_comparison') %}{% if overall_comparison %}<dl class="kv">{% for name in boss.playbook.primary_metrics %}{% set values = overall_comparison.metrics.get(name) %}{% if values %}<dt>{{ name|replace('_', ' ') }}</dt><dd>You: {{ values.yours if values.yours is not none else 'Unknown' }} · {{ overall_comparison.player }}: {{ values.reference if values.reference is not none else 'Unknown' }} · difference {{ '%.2f'|format(values.difference) if values.difference is not none else 'Unknown' }}</dd>{% endif %}{% endfor %}</dl>{% endif %}
  </details>
  <details class="cohort-details"><summary>Faction comparison cohort — build / race / buffs / gear</summary><div class="table-wrap cohort-table-wrap"><table class="cohort-table stack"><thead><tr><th>#</th><th>{{ doc.class_name }}</th><th>Faction</th><th>Race evidence</th><th>Build</th><th>Duty</th><th>Kill</th><th>Starting world buffs</th></tr></thead><tbody>{% for row in ref.cohort %}{% set e = row.entry %}<tr class="{{ row.row_class }}"><td data-label="Rank">{{ e.leaderboard_position or 'Unknown' }}</td><th scope="row"><a href="https://vanilla.warcraftlogs.com/reports/{{ e.report_code }}#fight={{ e.fight_id }}" target="_blank" rel="noopener noreferrer">{{ e.player }}</a></th><td data-label="Faction">{{ ev(e.environment.faction) }}</td><td data-label="Race">{{ ev(e.environment.race.race) }}</td><td data-label="Build">{{ ev(e[doc.analysis_key].build) }}</td><td data-label="Duty">{{ ev(e[doc.analysis_key].role) }}</td><td data-label="Kill">{{ e.kill_duration_s }} s</td><td data-label="World buffs">{{ (e.environment.world_buffs.value or [])|join(', ') if e.environment.world_buffs.value is not none else 'Unknown' }}</td></tr>{% else %}<tr><td colspan="8">No same-faction event sources acquired. Saved ranking context remains separate.</td></tr>{% endfor %}</tbody></table></div></details>
  <details class="hunter-gear"><summary>Full logged gear for each faction source</summary><div class="hunter-cards">{% for row in ref.cohort %}<article class="hunter-card {{ row.row_class }}"><div class="hunter-title"><strong>#{{ row.entry.leaderboard_position or '?' }} {{ row.entry.player }}</strong><span>{{ ev(row.entry[doc.analysis_key].build) }}</span></div>{{ equipment(row.gear) }}</article>{% endfor %}</div></details>
  <details><summary>All recorded cohort entries and evidence</summary>
    <div class="table-wrap" role="region" aria-label="Detailed analysis table" tabindex="0"><table><thead><tr><th>Player</th><th>Faction</th><th>Build</th><th>WCL category</th><th>Observed role</th><th>Fight</th></tr></thead><tbody>{% for e in boss.overall_cohort %}<tr><td>{{ e.player }}</td><td>{{ ev(e.environment.faction) }}</td><td>{{ ev(e[doc.analysis_key].build) }}</td><td>{{ ev(e[doc.analysis_key].ranking_category) }}</td><td>{{ ev(e[doc.analysis_key].role) }}</td><td>{{ e.report_code }}/{{ e.fight_id }}</td></tr>{% endfor %}</tbody></table></div>
    <p>Full evidence references and coverage proofs are retained in <a href="analysis.json">analysis.json</a> and the package.</p>
    {% if boss.subject %}<pre>{{ boss.subject[doc.analysis_key].role|tojson(indent=2) }}</pre>{% endif %}
    {% for e in boss.overall_cohort %}
    <details><summary>{{ e.player }} · supporting detail</summary>
      <dl class="kv">{% for name, value in e[doc.analysis_key].metrics.items() %}<dt>{{ name|replace('_', ' ') }}</dt><dd>{{ ev(value) }}</dd>{% endfor %}</dl>
      <p>Spell counts: {{ ev(e[doc.analysis_key].casts) }}</p><p>Faction: {{ ev(e.environment.faction) }}</p>
      <p>Roles: {{ ev(e[doc.analysis_key].observed_roles) }} · assignment: {{ ev(e[doc.analysis_key].assignment) }}</p>
      <dl class="kv">{% for form, windows in e[doc.analysis_key].forms.items() %}<dt>{{ form }} intervals</dt><dd>{{ ev(windows) }}</dd>{% endfor %}</dl>
      <div class="table-wrap" role="region" aria-label="Detailed analysis table" tabindex="0"><table><thead><tr><th>Time (s)</th><th>Event / ability</th><th>Source → target</th><th>Amount</th><th>Event identity</th></tr></thead><tbody>{% for row in e[doc.analysis_key].timeline %}<tr><td>{{ row.t_s }}</td><td>{{ row.kind }} · {{ row.name or row.ability_id }}</td><td>{{ actor(e[doc.analysis_key], row.source_id) }} → {{ actor(e[doc.analysis_key], row.target_id) }}</td><td>{{ row.amount if row.amount is not none else 'Unknown' }}</td><td>{{ row.uid }}/{{ row.get('copy') if row.get('copy') is not none else 'Unknown' }}</td></tr>{% endfor %}</tbody></table></div>
    </details>
    {% endfor %}
  </details>
  <ul class="limitations">{% for limit in boss.playbook.limitations %}<li>{{ limit }}</li>{% endfor %}</ul>
  {% endif %}
</section>
{% endfor %}
{% endblock %}

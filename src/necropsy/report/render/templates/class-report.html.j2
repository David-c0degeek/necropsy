{% extends "base.html.j2" %}
{% macro ev(e) -%}
{% if e and e.value is not none %}{{ e.value }} <span class="level">{{ e.level }}</span>{% else %}<span class="unknown">Unknown</span>{% if e and e.note %} <span class="why">{{ e.note }}</span>{% endif %}{% endif %}
{%- endmacro %}
{% macro actor(d, id) -%}
{% set catalog = (d.get('actor_catalog') or {}).get('value') or {} %}{% set found = catalog.get(id|string) or {} %}{{ found.get('name') or ('Unresolved actor ' ~ id) }}{% if found.get('type') %} ({{ found.type }}){% endif %}
{%- endmacro %}
{% block title %}{{ doc.title }} · Druid {{ page }}{% endblock %}
{% block main %}
<section id="overview" class="hero">
  <h1 tabindex="-1">{{ doc.character }} · Druid {{ page|title }}</h1>
  {% set selected = doc.class_document.get('acquisition', {}).get('selected_category') %}
  {% set personal_count = doc.class_document.bosses|selectattr('subject')|list|length %}
  <p>{{ doc.realm }} · {{ doc.zone }} · {{ doc.mode }} · {{ doc.navigation|length }} encounters in this view</p>
  {% if selected %}<h2>Selected spec: {{ 'Tank (Guardian category)' if selected == 'Guardian' else selected }}</h2>{% endif %}
  <p>{{ personal_count }} encounters with your matching data · {{ doc.navigation|length - personal_count }} without personal analysis.</p>
  {% if selected and personal_count == 0 %}<p class="notice">Not enough personal data in {{ 'Tank' if selected == 'Guardian' else selected }} in the acquired logs. Eligible top-player examples are shown for learning where available.</p>{% endif %}
  <p>Build, WCL ranking category and observed encounter duties are separate. Each finding retains its evidence and limits.</p>
  <p><a href="analysis.json">Full analysis JSON</a> · <a href="{{ 'report.html' if page == 'playbook' else 'playbook.html' }}">{{ 'Full report' if page == 'playbook' else 'Practice playbook' }}</a></p>
  <details><summary>Coverage and acquisition limits</summary>
  <dl class="kv">{% for label, value in doc.coverage %}<dt>{{ label }}</dt><dd>{{ value }}</dd>{% endfor %}</dl>
  {% for limit in doc.limitations %}<p class="muted">{{ limit }}</p>{% endfor %}
  {% if doc.class_document.get('acquisition') %}
  {% if doc.class_document.acquisition.get('stopped') %}<p>Acquisition stopped: {{ doc.class_document.acquisition.stopped }}. Unacquired examples and baselines remain unknown; this does not establish that personal spec data never existed.</p>{% endif %}
  <div class="table-wrap"><table><thead><tr><th>Requested encounter</th><th>Attempted</th><th>Deep samples</th><th>Coverage</th></tr></thead><tbody>{% for record in doc.class_document.acquisition.bosses %}{% set coverage = record.get('coverage') or {} %}<tr><th>{{ record.boss }}</th><td>{{ record.get('attempted', true) }}</td><td>{{ coverage.get('usable_deep', 'Unknown') }}</td><td>{{ 'Complete' if coverage.get('complete') else 'Partial / not acquired' }}</td></tr>{% endfor %}</tbody></table></div>
  {% endif %}
  </details>
</section>
<section id="truth-model" class="notice">
  <details><summary>Evidence and comparison limits</summary><h2 tabindex="-1">Evidence and comparison limits</h2>
  <p>Role is inferred from repeated actions. Talents, form and leaderboard labels alone never prove assigned duties. Unknown values remain unknown.</p>
  <p>Only the same faction, build, category, role, metric, partition and encounter qualify for a baseline. Three known values are required. Mixed, uncertain and overridden duties have no whole-fight baseline.</p>
  <p>Healing is shaped by assignments, incoming damage and other healers. Guardian category DPS does not measure survival or threat. Raw event damage and healing remain separate from WCL category scores.</p>
  </details>
</section>
{% for boss in doc.class_document.bosses %}
<section id="boss-{{ boss.encounter_id }}" data-boss-name="{{ boss.boss|lower }}" class="boss-section">
  <h2 tabindex="-1">{{ boss.boss }}</h2>
  {% if not boss.subject %}
  <div class="notice"><p>{{ boss.playbook.get('personal_data', {}).get('message', 'Not enough personal data in this spec for this encounter.') }}</p>
  <p>Your performance is not assessed for this boss in the selected spec.</p>
  {% set excluded = boss.playbook.get('personal_data', {}).get('excluded_fight') %}{% if excluded %}<p>The acquired fight {{ excluded.report }}/{{ excluded.fight }} has inferred duty {{ excluded.inferred_role or 'unknown' }} and is excluded from personal analysis in this view.</p>{% endif %}
  {% if boss.playbook.get('personal_data', {}).get('reasons') %}<details><summary>Why personal data is unavailable</summary><ul>{% for reason in boss.playbook.personal_data.reasons %}<li>{{ reason }}</li>{% endfor %}</ul></details>{% endif %}</div>
  {% else %}
  {% set s = boss.subject %}{% set d = s.druid %}
  <p><a href="https://vanilla.warcraftlogs.com/reports/{{ s.report_code }}#fight={{ s.fight_id }}" rel="noreferrer">Source report {{ s.report_code }} / fight {{ s.fight_id }}</a> · source opens online when followed</p>
  <div class="quick-plan">
    <h3>Your practice notes</h3>
    <dl class="kv"><dt>Inferred encounter duty</dt><dd>{{ ev(d.role) }}</dd><dt>Build</dt><dd>{{ ev(d.build) }}</dd><dt>WCL category</dt><dd>{{ ev(d.ranking_category) }}</dd><dt>Fight duration</dt><dd>{{ s.kill_duration_s }} s</dd><dt>Assignment</dt><dd>{{ ev(d.assignment) }}</dd></dl>
    {% if d.override %}<p>User override: <strong>{{ d.override.role }}</strong> · {{ d.override.reason }}. Observed evidence above is retained; override excluded from aggregate comparisons.</p>{% endif %}
    <p>{{ boss.playbook.guidance }}</p>
    <p>{% for e in d.opener %}{{ ' → ' if not loop.first else '' }}{{ e.t_s }}s {{ e.name or e.ability_id }}{% else %}No recorded opener casts; this does not establish absence without complete coverage.{% endfor %}</p>
    {% if boss.recommendations %}{% for r in boss.recommendations %}<article class="card"><h4>{{ r.finding }}</h4><p>{{ r.recommendation }}</p><p class="muted">Confidence {{ r.confidence }} · {{ r.controllability }} · evidence: {{ r.evidence|join(', ') }}</p></article>{% endfor %}{% else %}<p>No evidence-supported execution change to recommend. Review assignments and compare the detailed timeline.</p>{% endif %}
  </div>
  <h3>Your measurements</h3>
  {% if boss.benchmarks.baseline.entries < 3 %}<p>No personal baseline: not enough comparable data in this spec. Your recorded measurements remain available.</p>{% endif %}
  <p>{{ boss.benchmarks.baseline.entries }} comparable entries; {{ boss.benchmarks.baseline.excluded_incompatible }} incompatible entries excluded. {{ boss.benchmarks.baseline.note }}</p>
  <div class="table-wrap"><table><thead><tr><th>Measurement</th><th>Yours</th><th>Comparable median</th><th>Known / unknown</th></tr></thead><tbody>
  {% for name, measurement in d.metrics.items() %}{% if page == 'report' or name in boss.playbook.get("primary_metrics", []) %}{% set median = boss.benchmarks.baseline.medians.get(name) %}
  <tr><th>{{ name|replace('_', ' ') }}</th><td>{{ ev(measurement) }}</td><td>{{ ev(median.value if median else none) }}</td><td>{{ median.n_known if median else 0 }} / {{ median.n_unknown if median else 0 }}</td></tr>{% endif %}{% endfor %}
  </tbody></table></div>
  <p>Saved WCL category score: {{ s.ranking.category_score if s.ranking.category_score is not none else 'Unknown' }} {{ s.ranking.metric or '' }} · {{ s.ranking.note }}</p>
  <details{% if page == 'report' %} open{% endif %}><summary>Observed roles, forms, resources and full timeline</summary>
    {% if page == 'playbook' %}<h3>All measurements</h3><dl class="kv">{% for name, value in d.metrics.items() %}<dt>{{ name|replace('_', ' ') }}</dt><dd>{{ ev(value) }}</dd>{% endfor %}</dl>{% endif %}
    <h3>Observed activity spans</h3><ul>{% for span in d.activity_spans %}<li>{{ span.role }}: {{ span.first_action_s }}–{{ span.last_action_s }} s; {{ span.casts_observed }} recorded casts · {{ (span.get("cast_share", 1) * 100)|round(1) }}% of categorized casts · {{ 'qualifying duty' if span.get("qualifies_as_duty", true) else 'minor action signal; assignment unproven' }}</li>{% else %}<li>No supported activity spans.</li>{% endfor %}</ul>
    <h3>Form intervals (report timestamps, ms)</h3><dl class="kv">{% for name, intervals in d.forms.items() %}<dt>{{ name }}</dt><dd>{{ ev(intervals) }}</dd>{% endfor %}</dl>
    <h3>Spell use</h3><p>{{ ev(d.casts) }}</p>
    <h3>Environment and external context</h3><dl class="kv"><dt>Faction</dt><dd>{{ ev(s.environment.faction) }}</dd><dt>Race</dt><dd>{{ ev(s.environment.race.race) }}</dd><dt>Starting world buffs</dt><dd>{{ ev(s.environment.world_buffs) }}</dd><dt>Windfury</dt><dd>{{ ev(s.environment.windfury.status_evidence) }}</dd></dl>
    <h3>Effective healing by spell</h3><p>{{ ev(d.get("healing_spells")) }}</p>
    <h3>Defensive aura uptime (s)</h3><dl class="kv">{% for name, value in d.get("defensive_uptime_s", {}).items() %}<dt>{{ name }}</dt><dd>{{ ev(value) }}</dd>{% endfor %}</dl>
    <h3>Targets and support</h3><dl class="kv"><dt>Effective healing by target</dt><dd>{% if d.healing_targets.value is not none %}{% for id, amount in d.healing_targets.value.items() %}{{ actor(d, id) }}: {{ amount }}{{ '; ' if not loop.last else '' }}{% else %}No recorded healing targets{% endfor %}{% else %}{{ ev(d.healing_targets) }}{% endif %}</dd><dt>Damage by target</dt><dd>{% if d.damage_targets.value is not none %}{% for id, amount in d.damage_targets.value.items() %}{{ actor(d, id) }}: {{ amount }}{{ '; ' if not loop.last else '' }}{% else %}No recorded damage targets{% endfor %}{% else %}{{ ev(d.damage_targets) }}{% endif %}</dd><dt>Deaths</dt><dd>{{ ev(d.deaths.deaths) }}</dd><dt>Threat</dt><dd>{{ ev(d.threat) }}</dd></dl>
    <h3>Resource observations</h3><ul>{% for r in d.resources %}<li>{{ r.t_s }} s · {{ ev(r.get("evidence")) }} · raw payload: {{ r.reading }} · event {{ r.event_uid }}</li>{% else %}<li>No actor-resolved resource readings. Resource availability remains unknown.</li>{% endfor %}</ul>
    <h3>Cooldown and utility casts</h3><ul>{% for e in d.cooldowns %}<li>{{ e.t_s }} s · {{ e.name }} · target {{ e.target_id }} · event {{ e.uid }}/{{ e.copy }}</li>{% else %}<li>No recorded cooldown casts. Check source coverage before claiming non-use.</li>{% endfor %}</ul>
    <h3>Full event timeline</h3><div class="table-wrap"><table><thead><tr><th>Time (s)</th><th>Event / ability</th><th>Source → target</th><th>Amount</th><th>Event identity</th></tr></thead><tbody>{% for e in d.timeline %}<tr><td>{{ e.t_s }}</td><td>{{ e.kind }} · {{ e.name or e.ability_id }}</td><td>{{ actor(d, e.source_id) }} → {{ actor(d, e.target_id) }}</td><td>{{ e.amount if e.amount is not none else 'Unknown' }}</td><td>{{ e.uid }}/{{ e.copy }}</td></tr>{% endfor %}</tbody></table></div>
  </details>
  {% endif %}
  {% set reference = boss.playbook.get('reference') %}
  <div class="quick-plan learning-example">
    <h3>Learn from top players in this spec</h3>
    {% if reference %}{% set rd = reference.druid %}
    <p><strong>{{ reference.player }}</strong> · {{ 'Rank #1 recorded example' if reference.leaderboard_position == 1 else 'Top acquired example · leaderboard #' ~ reference.leaderboard_position }}.</p>
    <p>{{ boss.playbook.reference_note }}</p>
    <dl class="kv"><dt>Inferred duty</dt><dd>{{ ev(rd.role) }}</dd><dt>Build</dt><dd>{{ ev(rd.build) }}</dd><dt>Faction</dt><dd>{{ ev(reference.environment.faction) }}</dd><dt>Fight duration</dt><dd>{{ reference.kill_duration_s }} s</dd></dl>
    <p>{{ boss.playbook.guidance }}</p>
    <p>Recorded opening example: {% for e in rd.opener %}{{ ' → ' if not loop.first else '' }}{{ e.t_s }}s {{ e.name or e.ability_id }}{% else %}Unknown{% endfor %}</p>
    <dl class="kv">{% for name in boss.playbook.primary_metrics %}<dt>{{ name|replace('_', ' ') }}</dt><dd>{{ ev(rd.metrics.get(name)) }}</dd>{% endfor %}</dl>
    <p><a href="https://vanilla.warcraftlogs.com/reports/{{ reference.report_code }}#fight={{ reference.fight_id }}" rel="noreferrer">Example source report / fight {{ reference.fight_id }}</a></p>
    {% else %}<p>No eligible event example was acquired in the selected spec. Unknown duty, incomplete coverage and incompatible categories do not become learning examples.</p>{% endif %}
    {% set top = boss.benchmarks.get('overall_top') %}
    {% if top %}<p>Saved overall #1 {{ top.category }} ranking: {{ top.player }} · {{ ev(top.category_score) }} {{ top.metric }}. {{ top.note }}</p>{% if not reference or reference.leaderboard_position != 1 %}<p>Overall #1 event example: unknown (not acquired or not eligible). Cross-faction acquisition can supply another-faction #1 when accessible.</p>{% endif %}
    {% else %}<p>Overall #1 ranking metadata: unknown (not acquired).</p>{% endif %}
  </div>
  <details><summary>All recorded cohort entries and evidence</summary>
    <div class="table-wrap"><table><thead><tr><th>Player</th><th>Faction</th><th>Build</th><th>WCL category</th><th>Observed role</th><th>Fight</th></tr></thead><tbody>{% for e in boss.overall_cohort %}<tr><td>{{ e.player }}</td><td>{{ ev(e.environment.faction) }}</td><td>{{ ev(e.druid.build) }}</td><td>{{ ev(e.druid.ranking_category) }}</td><td>{{ ev(e.druid.role) }}</td><td>{{ e.report_code }}/{{ e.fight_id }}</td></tr>{% endfor %}</tbody></table></div>
    <p>Full evidence references and coverage proofs are retained in <a href="analysis.json">analysis.json</a> and the package.</p>
    {% if boss.subject %}<pre>{{ boss.subject.druid.role|tojson(indent=2) }}</pre>{% endif %}
    {% for e in boss.overall_cohort %}
    <details><summary>{{ e.player }} · supporting detail</summary>
      <dl class="kv">{% for name, value in e.druid.metrics.items() %}<dt>{{ name|replace('_', ' ') }}</dt><dd>{{ ev(value) }}</dd>{% endfor %}</dl>
      <p>Spell counts: {{ ev(e.druid.casts) }}</p><p>Faction: {{ ev(e.environment.faction) }}</p>
      <p>Roles: {{ ev(e.druid.observed_roles) }} · assignment: {{ ev(e.druid.assignment) }}</p>
      <dl class="kv">{% for form, windows in e.druid.forms.items() %}<dt>{{ form }} intervals</dt><dd>{{ ev(windows) }}</dd>{% endfor %}</dl>
      <div class="table-wrap"><table><thead><tr><th>Time (s)</th><th>Event / ability</th><th>Source → target</th><th>Amount</th><th>Event identity</th></tr></thead><tbody>{% for row in e.druid.timeline %}<tr><td>{{ row.t_s }}</td><td>{{ row.kind }} · {{ row.name or row.ability_id }}</td><td>{{ actor(e.druid, row.source_id) }} → {{ actor(e.druid, row.target_id) }}</td><td>{{ row.amount if row.amount is not none else 'Unknown' }}</td><td>{{ row.uid }}/{{ row.copy }}</td></tr>{% endfor %}</tbody></table></div>
    </details>
    {% endfor %}
  </details>
  <ul class="limitations">{% for limit in boss.playbook.limitations %}<li>{{ limit }}</li>{% endfor %}</ul>
</section>
{% endfor %}
{% endblock %}

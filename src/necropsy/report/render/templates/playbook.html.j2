{% extends "base.html.j2" %}
{% from "pull-sheet.html.j2" import pull_sheet %}
{% block title %}Playbook · {{ doc.title }} · Necropsy{% endblock %}
{% block main %}
{% include "overview.html.j2" %}
<p class="notice"><span id="review-status">Review marks are saved only in this browser, for this exact analysis.</span> <button type="button" id="reset-reviews">Clear review marks</button></p>
{% for boss in doc.bosses %}
{% set ref = boss.reference %}
<section class="boss" id="{{ boss.anchor }}" aria-labelledby="{{ boss.anchor }}-title">
  <div class="boss-head"><div><div class="eyebrow">Boss {{ "%02d"|format(loop.index) }}</div><h2 id="{{ boss.anchor }}-title" tabindex="-1">{{ boss.name }}</h2></div><label class="done"><input type="checkbox" data-review-key="{{ ref.review_key }}"> reviewed<span class="sr">: {{ boss.name }}</span></label></div>
  {% set triage = doc.experience.bosses[loop.index0] %}
  {% if triage.limited %}<p class="table-note">{{ triage.quality }}. Advice may be limited by the available comparisons.</p>{% endif %}
  {{ pull_sheet(ref, boss.ordered_cards, boss.anchor, boss.has_subject) }}
  {% if not boss.has_subject and ref.leader_practice %}<p>Recorded faction example: {{ ref.leader_practice.player }}. <a href="report.html#{{ boss.anchor }}">Review the recorded opening and ability use before practicing →</a></p>{% endif %}
</section>
{% endfor %}
{% endblock %}

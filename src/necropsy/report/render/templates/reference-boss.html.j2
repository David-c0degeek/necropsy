{% from "reference-macros.html.j2" import prose, equipment, plans %}
{% from "macros.html.j2" import val, card %}
{% from "ability-use.html.j2" import ability_use %}
{% set ref = boss.reference %}
<div class="boss-head">
  <div>
    <div class="eyebrow">Boss {{ "%02d"|format(boss_number) }} · {{ boss.name }}</div>
    <h2 id="{{ boss.anchor }}-title" tabindex="-1">{{ boss.name }}</h2>
    <div class="metrics">{% for label, value in ref.metrics %}{% if label != 'Overall #1 DPS' %}<div><b>{{ val(value) }}</b><span>{{ label }}</span></div>{% endif %}{% endfor %}</div>
  </div>
  <label class="done"><input type="checkbox" data-review-key="{{ ref.review_key }}"> reviewed<span class="sr">: {{ boss.name }}</span></label>
</div>
{% set triage = doc.experience.bosses[boss_number - 1] %}
<div class="quality-strip"><strong>{{ triage.quality }}</strong><span>{{ triage.sources }} comparable sources{% if triage.membership_label %} · {{ triage.membership_label }}{% endif %} · {{ boss.cards|length }} findings</span>{% if boss.limits %}<span>Comparison limits apply</span>{% endif %}</div>
<nav class="boss-jumps" aria-label="{{ boss.name }} sections"><a href="#{{ boss.anchor }}-actions">What to work on</a><a href="#{{ boss.anchor }}-plan">Next pull</a><a href="#{{ boss.anchor }}-comparison">Compare</a><a href="#{{ boss.anchor }}-evidence">Evidence</a></nav>
<div class="boss-actions" id="{{ boss.anchor }}-actions">
  <h3 class="section-title">What to work on</h3>
  {% if boss.cards %}{% set ordered = boss.ordered_cards %}<div class="cards">{% for c in ordered[:2] %}{{ card(c, review=True) }}{% endfor %}</div>{% if ordered|length > 2 %}<details class="more-actions"><summary>{{ ordered|length - 2 }} more findings · all priorities and controls</summary><div class="cards">{% for c in ordered[2:] %}{{ card(c, review=True) }}{% endfor %}</div></details>{% endif %}
  {% else %}<p class="muted">{{ 'No supported finding was generated. Check comparison and coverage limits before drawing conclusions.' if boss.has_subject else 'No personal fight in this snapshot; your performance is not assessed.' }}</p>{% endif %}
</div>
{% if page == 'report' %}{% if boss.execution %}<section class="comparison-snapshot" id="{{ boss.anchor }}-comparison"><h3>Compared with your faction</h3>
{% for r in boss.execution %}<div class="comparison-row"><h4>{{ r.label }}</h4><div class="comparison-values"><div><span>You</span><strong>{{ val(r.yours) }}</strong></div><div><span>Comparable median</span><strong>{{ val(r.baseline) }}</strong></div></div><p class="table-note">{{ r.sample }}</p></div>{% endfor %}
</section>{% endif %}
{% endif %}
<article class="quick-plan" id="{{ boss.anchor }}-plan">
  <div class="eyebrow">Prepare for your next attempt</div>
  <h3>Your next pull</h3>{{ '\n' }}{% if doc.selected_spec and ref.leader_practice %}{% set leader = ref.leader_practice %}<p>No personal {{ doc.selected_spec }} encounter was found in the acquired logs. Use this faction leader's recorded ability mix as a practice reference: {{ leader.player }} · leaderboard #{{ leader.leaderboard_position }} · {{ leader.kill_duration_s }} s fight.</p><dl class="kv">{% for spell, shot in leader.hunter.shots.items() %}<dt>{{ spell|replace('_', ' ') }}</dt><dd>{{ shot.casts.value|length if shot.casts.value is not none else 'Unknown' }} recorded casts</dd>{% endfor %}</dl><p>Check assignments, gear and fight duration before copying this example. It is a learning reference, not a grade of your performance.</p>{% endif %}
  {{ plans(ref.quick_plan) }}<details><summary>Compare ability use with the reference player</summary>{{ ability_use(ref.ability_use) if ref.ability_use else "" }}</details>
</article>
<details class="preparation-details"{% if page == "playbook" %} open{% endif %}><summary>Loadout and execution plan</summary>
<div class="grid two">
  <article><h3>Loadout plan</h3>{{ plans(ref.loadout) }}</article>
  <article><h3>Execution plan</h3>{{ plans(ref.execution) }}</article>
</div>
</details>
<div class="grid two warnings">
  <article class="dont"><h3>Do not</h3>{{ prose(ref.dont) }}</article>
  <article class="ask"><h3>Raid help</h3>{{ prose(ref.asks) }}</article>
</div>
{% if page == 'playbook' %}{% if boss.execution %}<section class="comparison-snapshot" id="{{ boss.anchor }}-comparison"><h3>Compared with your faction</h3>
{% for r in boss.execution %}<div class="comparison-row"><h4>{{ r.label }}</h4><div class="comparison-values"><div><span>You</span><strong>{{ val(r.yours) }}</strong></div><div><span>Comparable median</span><strong>{{ val(r.baseline) }}</strong></div></div><p class="table-note">{{ r.sample }}</p></div>{% endfor %}
</section>{% endif %}
{% endif %}
<h3 id="{{ boss.anchor }}-evidence" tabindex="-1">Evidence and details</h3>
<details class="comparison-context"><summary>Who are you being compared with?</summary><div>
<div class="context-strip">{% for label, value in ref.context %}<div><span>{{ label }}</span><strong>{{ value }}</strong></div>{% endfor %}</div>
<p>Selected spec: {{ doc.selected_spec or 'Not selected' }} · faction: {{ doc.experience.faction }}. Main comparisons use this faction.</p><details class="overall-comparison"><summary>Optional: overall top across factions</summary><p>This comparison is unfiltered by faction. Different races, faction-specific buffs, assignments and fight duration can affect it.</p>{% for label, value in ref.metrics %}{% if label == 'Overall #1 DPS' %}<p>{{ label }}: {{ val(value) }}</p>{% endif %}{% endfor %}{% if ref.overall_identity %}<p>{{ ref.overall_identity.player }} · faction {{ val(ref.overall_identity.faction) }}. Your selected faction: {{ doc.selected_faction or 'Unproven' }}.</p>{% else %}<p>Overall leader was not recorded in this analysis.</p>{% endif %}</details>
<article class="truth-card">
  <h3>Benchmark context</h3><p>{{ ref.context_text }}</p>
  <p class="tiny">{% if ref.show_race %}Race is confirmed only by affirmative racial evidence.{% else %}Race is unproven for these entries; it is not guessed from faction or non-use.{% endif %} WF counts detected extra-attack events; no procs observed means there is no proc damage to attribute, not proof of totem unavailability. Other-faction rows below are context.</p>
  {% for limit in ref.limits %}<p class="tiny">{{ limit }}</p>{% endfor %}
</article>

</div></details>
{% if ref.facts %}<details><summary>Encounter knowledge and sources</summary><div>{{ prose(ref.facts) }}</div></details>{% endif %}
<details class="full-gear"><summary>Your full logged gear for this selected best parse</summary><div>{{ equipment(ref.gear) }}</div></details>
<details class="cohort-details">
  <summary>{{ ref.cohort_title }} — faction / race evidence / Windfury / gear / pet</summary>
  <div>
    {% if not ref.cohort_complete %}<p class="notice">This older analysis contains only its comparison rows; rebuild from the archive for the {% if doc.mode == "live" %}acquired comparison cohort{% else %}complete recorded overall top five{% endif %}.</p>{% endif %}
    <div class="table-wrap cohort-table-wrap" role="region" aria-label="{{ boss.name }}: {{ ref.cohort_title }}" tabindex="0">
      <table class="cohort-table stack">
        <thead><tr><th scope="col">#</th><th scope="col">Hunter</th><th scope="col">Faction</th>{% if ref.show_race %}<th scope="col">Race evidence</th>{% endif %}<th scope="col">WF procs</th><th scope="col">DPS</th><th scope="col">Spec</th><th scope="col">Trinkets</th><th scope="col">Weapons</th><th scope="col">Raptor</th><th scope="col">White</th><th scope="col">Pet</th><th scope="col">Pet DPS</th></tr></thead>
        <tbody>{% for e in ref.cohort %}<tr class="{{ e.class }}">
          <td data-label="Rank">{{ e.rank if e.rank is not none else "Unknown" }}</td>
          <th scope="row">{{ e.player }}<span class="why">Recorded overall leaderboard · {{ e.kill }} kill</span></th>
          <td data-label="Faction">{{ val(e.faction) }}</td>{% if ref.show_race %}<td data-label="Race evidence">{{ val(e.race) }}{% if e.race_note %}<span class="why">{{ e.race_note }}</span>{% endif %}</td>{% endif %}
          <td data-label="WF procs">{{ val(e.wf) }}<span class="why">{{ e.wf_status }}</span></td><td data-label="DPS">{{ e.dps }}{% if e.dps_note %}<span class="why">{{ e.dps_note }}</span>{% endif %}</td><td data-label="Spec">{{ val(e.spec) }}</td>
          <td data-label="Trinkets">{{ val(e.trinkets) }}</td><td data-label="Weapons">{% for weapon in e.weapons %}{{ val(weapon) }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td>
          <td data-label="Raptor">{{ val(e.raptor) }}</td><td data-label="White">{{ val(e.white) }}</td>
          <td data-label="Pet">{{ e.pet.name }}{% for f in e.pet.family %}<div>{{ val(f) }}</div>{% endfor %}<span class="why">{{ e.pet.abilities }}</span></td><td data-label="Pet DPS">{{ val(e.pet.dps) }}</td>
        </tr>{% endfor %}</tbody>
      </table>
    </div>
    <p class="table-note">All recorded rows are shown. Faction colors indicate the returned faction; its evidence label still applies. Family inference stays qualified. Raptor/white counts need complete streams. Gear is the recorded pull snapshot, not proof of in-fight swaps.</p>
  </div>
</details>
<details class="hunter-gear"><summary>{{ ref.gear_title }}</summary><div class="hunter-cards">
  {% for e in ref.cohort %}<article class="hunter-card {{ e.class }}">
    <div class="hunter-title"><div><strong>#{{ e.rank if e.rank is not none else "?" }} {{ e.player }}</strong><span>{{ e.faction.text }} · {{ e.dps }} DPS · {{ e.spec.text }}</span></div>
      <div class="mini-badges"><em>Raptor {{ e.raptor.text }}</em><em>White {{ e.white.text }}</em><em>WF procs {{ e.wf.text }}</em></div>
    </div>{{ equipment(e.gear) }}
  </article>{% endfor %}
</div></details>

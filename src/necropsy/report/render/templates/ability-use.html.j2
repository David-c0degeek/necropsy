{% macro ability_use(comparison) %}
{% if comparison %}
<section class="ability-use" aria-label="Ability use comparison">
  <h3>Ability use vs {{ comparison.player }}</h3>
  <p>Leaderboard #{{ comparison.rank if comparison.rank is not none else 'Unknown' }} · 1 recorded reference. Counts and uses per minute describe these encounters; fight duration and assignments can change ability choices.</p>
  <p>Your fight: {{ '%.1f s'|format(comparison.your_seconds) if comparison.your_seconds is not none else 'Unknown' }} · {{ comparison.player }} fight: {{ '%.1f s'|format(comparison.reference_seconds) }}. Each rate uses that player's full fight duration.</p>
  {% if not comparison.personal %}<p>No personal encounter to compare. The faction leader's recorded abilities remain a practice reference.</p>{% endif %}
  <div class="table-wrap"><table class="stack"><thead><tr><th>Ability</th><th>Your uses</th><th>{{ comparison.player }} uses</th><th>Your uses/min</th><th>{{ comparison.player }} uses/min</th></tr></thead><tbody>
  {% for row in comparison.rows %}<tr><th scope="row">{{ row.spell }}</th><td data-label="Your uses">{{ row.counts.yours if row.counts.yours is not none else 'Unknown' }}</td><td data-label="Reference uses">{{ row.counts.reference if row.counts.reference is not none else 'Unknown' }}</td><td data-label="Your uses/min">{{ '%.2f'|format(row.per_minute.yours) if row.per_minute.yours is not none else 'Unknown' }}</td><td data-label="Reference uses/min">{{ '%.2f'|format(row.per_minute.reference) if row.per_minute.reference is not none else 'Unknown' }}</td></tr>
  {% else %}<tr><td colspan="5">No ability counts available. Incomplete coverage does not prove non-use.</td></tr>{% endfor %}</tbody></table></div>
  <p class="table-note">{{ comparison.note }} Sources: <a href="https://vanilla.warcraftlogs.com/reports/{{ comparison.report }}#fight={{ comparison.fight }}" rel="noreferrer">Reference report / fight {{ comparison.fight }}</a>. Uses count actor cast events, not passive damage ticks or pet actions. A missing ability is zero only with complete coverage.</p>
</section>
{% else %}<section class="ability-use"><h3>Ability use comparison</h3><p>Not measured for this encounter: no eligible faction leader's ability stream was acquired. Missing coverage does not prove non-use.</p></section>
{% endif %}
{% endmacro %}
